# Application
HOST=127.0.0.1
PORT=8787
DATABASE_URL=sqlite+aiosqlite:///./data/leads.db

# Scraping (keep it slow: fewer Google captchas)
HEADLESS=true
TURBO_MODE=false
# Facebook/Instagram lookup searches Google for every lead and triggers captchas. Leave true.
SKIP_SOCIAL=true
MAPS_DAILY_CAP=200
SCROLL_PAUSE_MIN_MS=1500
SCROLL_PAUSE_MAX_MS=4500
LISTING_PAUSE_MIN_MS=3000
LISTING_PAUSE_MAX_MS=8000
MAPS_LOCALE=ar-EG

# Overnight batch mode: rest between each niche/city job (milliseconds)
BATCH_REST_MIN_MS=60000
BATCH_REST_MAX_MS=180000

# Parallel agents (maps listing workers + social lookup workers)
MAPS_WORKERS=3
SOCIAL_WORKERS=2

# Proxies — strongly recommended to avoid Google captcha
PROXY_ENABLED=false
PROXY_FILE=proxies.txt
PROXY_ROTATE_EVERY=25
CAPTCHA_COOLDOWN_SECONDS=90
CAPTCHA_MAX_RETRIES=3

# Paths (relative to project root)
EXPORTS_DIR=./exports
PROFILES_DIR=./profiles

# Proxies — strongly recommended to avoid captcha
PROXY_ENABLED=false
# Or paste proxies comma-separated here:
# PROXIES=http://user:pass@host:10001,http://user:pass@host:10002
PROXY_FILE=proxies.txt
PROXY_ROTATE_EVERY=25
CAPTCHA_COOLDOWN_SECONDS=90
CAPTCHA_MAX_RETRIES=3
